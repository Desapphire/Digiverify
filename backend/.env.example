# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=digiverify_admin
PGPASSWORD=your_secure_password_here
PGDATABASE=digiverify

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_jwt_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── Blockchain (Ethereum Sepolia Testnet) ─────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID=11155111
SIGNER_PRIVATE_KEY=your_server_wallet_private_key_here

# ─── Smart Contract Suite Addresses (Ethereum Sepolia) ──────
LAND_NFT_ADDRESS=0xbCB28DC4eF6242572c0a65D1643595C582106249
LAND_REGISTRY_ADDRESS=0xd6e6e94c053D204Ad535Ef8f2b01A1835696e9B1
SALE_CONTRACT_ADDRESS=0xA94321fA51b6F600Ef32Ab652965AC689D967b9B
COURT_OVERRIDE_ADDRESS=0x4437904bF4cff91E91c16bB135752038d3418B8C
BANK_LIEN_REGISTRY_ADDRESS=0x6E8953f0288820bDB77CA89eaAF6c54Ff1250300
INHERITANCE_SUCCESSION_ADDRESS=0x712a073f1849456b13c983195a62fc79D50F52B8
PROPERTY_TAX_VAULT_ADDRESS=0x4bC7B4A62b7a97c40Bf4F028EbF043Fb0AbB7999
CITIZEN_IDENTITY_REGISTRY_ADDRESS=0xCaa02E5ba741c314c12563dBE2eABCd2d6c5c6a3

# ─── Pinata IPFS (Decentralized Metadata & Documents) ──────
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# ─── AWS Rekognition (Biometric Face Verification) ─────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ─── CORS & Security ──────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ENCRYPTION_KEY=your_32_char_encryption_key_here
SESSION_SECRET=your_session_secret_here

# ─── Redis (optional caching) ────────────────────────────
REDIS_URL=redis://localhost:6379
