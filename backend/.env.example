# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=digiverify_admin
PGPASSWORD=your_secure_password_here
PGDATABASE=digiverify

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_jwt_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── Blockchain (Avalanche Fuji C-Chain) ─────────────────
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
SIGNER_PRIVATE_KEY=your_server_wallet_private_key_here

# Contract Addresses (deployed on Fuji Testnet)
LAND_NFT_ADDRESS=0x0000000000000000000000000000000000000000
LAND_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SALE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Redis (optional caching) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Encryption ──────────────────────────────────────────
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ─── Session (legacy — can be removed after migration) ───
SESSION_SECRET=your_session_secret_here
